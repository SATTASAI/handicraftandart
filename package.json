{
  "name": "handicraftandart",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4173 --strictPort",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "db:remote": "wrangler d1 migrations apply handicraftandart --remote",
    "deploy": "npm run build && npm run db:remote && wrangler deploy"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "vite": "6.4.2",
    "@vitejs/plugin-react": "5.0.4",
    "miniflare": "5.20261101.0-beta",
    "wrangler": "4.156.1",
    "prettier": "^3.9.10"
  }
}
