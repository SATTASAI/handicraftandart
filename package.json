{
  "name": "handicraftandart",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "dev:worker": "wrangler dev --port 8787",
    "dev:full": "npm run build && wrangler dev --port 8787",
    "db:local": "wrangler d1 migrations apply handicraftandart --local",
    "db:remote": "wrangler d1 migrations apply handicraftandart --remote",
    "deploy": "npm run build && wrangler deploy",
    "test": "node --test tests/security.test.mjs tests/api.test.mjs tests/certificate.test.mjs tests/admin-setup.test.mjs",
    "format": "prettier --write src server scripts tests vite.config.mjs wrangler.jsonc",
    "dev:api": "node scripts/local-api.mjs"
  },
  "dependencies": {
    "@fontsource/noto-sans-thai": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@vitejs/plugin-react": "5.0.4",
    "pdf-lib": "^1.17.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "miniflare": "^5.20261101.0-beta",
    "prettier": "^3.9.10",
    "wrangler": "^4.156.1"
  }
}
